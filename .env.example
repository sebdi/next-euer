# PostgreSQL connection string for this instance.
# Use a pooled URL for the running app on Vercel (for example Neon pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# GitHub OAuth App credentials (Settings → Developer settings → OAuth Apps).
# Authorization callback URL:
#   Local:      http://localhost:3000/api/auth/callback/github
#   Production: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Numeric GitHub account ID that may use this deployment.
# Look it up at https://api.github.com/users/YOUR_USERNAME (field "id").
# Do not use the username or email address.
GITHUB_ALLOWED_USER_ID=""

# Random secret used to sign Auth.js session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional. Set to your public origin in production if Auth.js cannot infer it.
# AUTH_URL="https://YOUR_DOMAIN"

# Distance provider used for Fahrtkosten. "heigit" is the default.
# HeiGIT key: create a free key at https://api.heigit.org/ and copy it from the account dashboard.
# DISTANCE_PROVIDER="heigit"
HEIGIT_API_KEY=""
