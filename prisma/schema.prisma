generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Financial booking for one self-hosted deployment (single authorized user).
model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  category     String
  account      String
  description  String
  date         DateTime @db.Date
  incomeCents  BigInt   @default(0)
  expenseCents BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([date, category])
  @@map("transactions")
}
