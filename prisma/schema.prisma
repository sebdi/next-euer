generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Financial booking for one self-hosted deployment (single authorized user).
model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  category     String
  account      String
  description  String
  date         DateTime @db.Date
  incomeCents  BigInt   @default(0)
  expenseCents BigInt   @default(0)
  /// Original gross amount when only 70% of Bewirtungskosten is booked.
  grossCents       BigInt?
  routeOrigin      String?
  routeDestination String?
  distanceMeters   Int?
  rateCentsPerKm   Int?
  /// True when the booked amount uses the route twice (return trip).
  roundTrip        Boolean?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([date, category])
  @@map("transactions")
}

/// Settings for the single authorized GitHub account of this deployment.
model Profile {
  githubId    String   @id
  homeAddress String?
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}
